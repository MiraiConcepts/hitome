     private PendingIntent createPendingIntent(Bundle clickableArea) {
+        // hitome patch: OPEN_URI taps in list items also get a direct ACTION_VIEW
+        // PendingIntent (see RNWidgetUtil.createOpenUriPendingIntent for rationale).
+        if ("OPEN_URI".equals(clickableArea.getString("clickAction"))) {
+            Bundle clickActionData = clickableArea.getBundle("clickActionData");
+            String uri = clickActionData != null ? clickActionData.getString("uri") : null;
+            if (uri != null) {
+                PendingIntent uriPendingIntent = RNWidgetUtil.createOpenUriPendingIntent(
+                    mContext,
+                    uri,
+                    (int) System.currentTimeMillis()
+                );
+                if (uriPendingIntent != null) {
+                    return uriPendingIntent;
+                }
+            }
+        }
         Intent intent = new Intent(mContext.getPackageName() + ".WIDGET_CLICK");
         intent.setComponent(new ComponentName(mContext, RNWidgetUtil.getWidgetProviderClassName(mContext, widgetName)));
         intent.putExtra("widgetId", mAppWidgetId);
